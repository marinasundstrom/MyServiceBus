<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Sundstrom.MyServiceBus.Inspection</PackageId>
    <Description>Queryable bus metadata and topology inspection APIs for MyServiceBus.</Description>
    <PackageTags>$(PackageTags);inspection;topology;observability</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MyServiceBus/MyServiceBus.csproj" />
  </ItemGroup>

</Project>
