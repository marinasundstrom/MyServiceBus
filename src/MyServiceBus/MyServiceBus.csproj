<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="'$(IncludeExperimentalNet11Target)' == 'true'">net10.0;net11.0</TargetFrameworks>
    <TargetFramework Condition="'$(IncludeExperimentalNet11Target)' != 'true' and '$(EnableNet11RuntimeAsyncTarget)' != 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(IncludeExperimentalNet11Target)' != 'true' and '$(EnableNet11RuntimeAsyncTarget)' == 'true'">net11.0</TargetFramework>
    <Features Condition="'$(TargetFramework)' == 'net11.0'">$(Features);runtime-async=on</Features>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Sundstrom.MyServiceBus</PackageId>
    <Description>Cross-language messaging runtime with MassTransit-compatible concepts and wire conventions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MyServiceBus.Abstractions/MyServiceBus.Abstractions.csproj" />
  </ItemGroup>

</Project>
