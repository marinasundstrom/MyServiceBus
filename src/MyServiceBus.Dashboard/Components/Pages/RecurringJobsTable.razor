<section class="panel instances scheduled-work-panel">
    <div class="section-heading"><div><p class="eyebrow">Definitions</p><h2>Recurring jobs</h2></div><span>@Items.Count defined · cadence and next planned occurrence</span></div>
    @if (Items.Count == 0)
    {
        <p class="panel-empty">No recurring jobs have been reported. The application may not use recurring work, may be offline, or its configured provider may not expose definitions yet.</p>
    }
    else
    {
        <div class="table-wrap"><table>
            <thead><tr><th>Status</th><th>Application</th><th>Job</th><th>Cadence</th><th>Next run</th><th>Provider</th><th>Reported by</th></tr></thead>
            <tbody>
                @foreach (var item in PageItems)
                {
                    <tr>
                        <td><span class="status-dot @StatusClass(item.Job.Status)"></span><strong>@item.Job.Status</strong><small>Revision @item.Job.Revision</small></td>
                        <td><a href="@($"/applications/{Uri.EscapeDataString(item.ApplicationName)}/recurring")">@item.ApplicationName</a></td>
                        <td><strong>@item.Job.ScheduleId</strong><small>@(item.Job.ScheduleGroup ?? "Default group") · @ShortMessageType(item.Job.MessageType)</small></td>
                        <td>@item.Job.Cadence</td>
                        <td>@FormatNext(item.Job.NextOccurrenceAtUtc)<small>Snapshot @item.CapturedAtUtc.LocalDateTime.ToString("HH:mm:ss")</small></td>
                        <td>@item.Job.Provider<small>@item.Job.Durability · @item.Job.Placement</small></td>
                        <td><span class="status-dot @(item.InstanceOnline ? "online" : "offline")"></span>@(item.InstanceOnline ? "Online" : "Offline")<small class="mono">@item.InstanceId</small></td>
                    </tr>
                }
            </tbody>
        </table></div>
        <ListPagination Offset="EffectiveOffset" PageSize="PageSize" ItemCount="PageItems.Count" Total="Items.Count" PageChanged="ChangePageAsync" />
    }
</section>

@code {
    private const int PageSize = 25;

    [Parameter, EditorRequired]
    public required IReadOnlyList<MonitoringRecurringJobSummary> Items { get; set; }

    private int offset;
    private int EffectiveOffset => Items.Count == 0 ? 0 : Math.Min(offset, (Items.Count - 1) / PageSize * PageSize);
    private IReadOnlyList<MonitoringRecurringJobSummary> PageItems => Items.Skip(EffectiveOffset).Take(PageSize).ToArray();

    private Task ChangePageAsync(int value)
    {
        offset = value;
        return Task.CompletedTask;
    }

    private static string StatusClass(string status) => status switch
    {
        "Active" => "online",
        "Paused" => "degraded",
        _ => "offline"
    };

    private static string FormatNext(DateTimeOffset? value)
        => value is { } next ? next.LocalDateTime.ToString("MMM d, HH:mm:ss") : "Not scheduled";

    private static string ShortMessageType(string value) => value.Split('.').Last();
}
