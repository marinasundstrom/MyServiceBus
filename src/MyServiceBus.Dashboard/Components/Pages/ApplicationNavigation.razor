<nav class="application-navigation" aria-label="Application sections">
    <NavLink href="@ApplicationUrl" Match="NavLinkMatch.All">Overview</NavLink>
    <NavLink href="@($"{ApplicationUrl}/metrics")">Metrics</NavLink>
    <NavLink href="@($"{ApplicationUrl}/flow")">Flow</NavLink>
    <NavLink href="@($"{ApplicationUrl}/workflows")">Workflows</NavLink>
    <NavLink href="@($"{ApplicationUrl}/scheduled")">Scheduled</NavLink>
    <NavLink href="@($"{ApplicationUrl}/recurring")">Recurring</NavLink>
    <NavLink href="@($"{ApplicationUrl}/jobs")">Jobs</NavLink>
</nav>

@code {
    [Parameter, EditorRequired]
    public required string ApplicationName { get; set; }

    private string ApplicationUrl => $"/applications/{Uri.EscapeDataString(ApplicationName)}";
}
