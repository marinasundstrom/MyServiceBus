@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<div class="flow-map-shell replica-flow-map-shell" @ref="_map">
    <svg class="flow-map-canvas replica-flow-map-canvas" role="img" aria-label="Observed message flow between replicas grouped by application"></svg>
    <div class="flow-map-controls" aria-label="Detailed flow map controls">
        <button type="button" data-replica-flow-action="zoom-in" title="Zoom in" aria-label="Zoom in">+</button>
        <button type="button" data-replica-flow-action="zoom-out" title="Zoom out" aria-label="Zoom out">−</button>
        <button type="button" data-replica-flow-action="reset" title="Reset view" aria-label="Reset view">↺</button>
    </div>
</div>

@code {
    private ElementReference _map;
    private IJSObjectReference? _module;

    [Parameter, EditorRequired]
    public required IReadOnlyList<MonitoringInstanceSummary> Instances { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<MonitoringReplicaFlowEdge> Edges { get; set; }

    [Parameter]
    public string? FocusApplication { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./monitoringChart.js");
        if (firstRender)
            await _module.InvokeVoidAsync("initializeReplicaFlowMap", _map);
        await _module.InvokeVoidAsync(
            "updateReplicaFlowMap",
            _map,
            new
            {
                Nodes = Instances.Select(instance => new
                {
                    Id = ReplicaId(instance.ApplicationName, instance.InstanceId, instance.BusId),
                    Application = instance.ApplicationName,
                    instance.InstanceId,
                    instance.BusId,
                    instance.Online,
                    IsFocus = string.Equals(instance.ApplicationName, FocusApplication, StringComparison.Ordinal)
                }),
                Links = Edges.Select(edge => new
                {
                    Source = ReplicaId(edge.SourceApplication, edge.SourceInstanceId, edge.SourceBusId),
                    Target = ReplicaId(edge.TargetApplication, edge.TargetInstanceId, edge.TargetBusId),
                    edge.MessageType,
                    edge.EndpointName,
                    edge.Count
                }),
                WindowSeconds = 300
            });
    }

    private static string ReplicaId(string application, string instanceId, string busId)
        => $"{application}\u001f{instanceId}\u001f{busId}";

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("disposeReplicaFlowMap", _map);
                await _module.DisposeAsync();
            }
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }
}
