@page "/workflows/declared"
@rendermode InteractiveServer
@inherits MonitoringPageBase

<PageTitle>Declared Workflows · MyServiceBus Monitoring</PageTitle>
<DashboardPageHeader Eyebrow="Coordination" Title="Workflows" Description="Explore declared choreography and saga state machines through one catalog, then open the kind-specific model that preserves how each workflow is actually coordinated." />
<WorkflowTabs Active="declared" />

<section class="panel workflow-run-index">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Shared catalog</p>
            <h2>Declared workflows</h2>
        </div>
        <span>@Dashboard.WorkflowCatalog.Count definitions · choreography and saga records remain separate</span>
    </div>
    @if (Dashboard.WorkflowCatalog.Count == 0)
    {
        <div class="panel-empty">Applications appear here after they export choreography fragments or saga state-machine definitions.</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Workflow</th><th>Kind</th><th>Versions</th><th>Ownership</th><th>Availability</th><th>Observed runs</th><th></th></tr></thead>
                <tbody>
                @foreach (var workflow in Dashboard.WorkflowCatalog)
                {
                    <tr>
                        <td><strong>@workflow.WorkflowId</strong><small>@AuthorityLabel(workflow.LifecycleAuthority)</small></td>
                        <td>@KindLabel(workflow.Kind)</td>
                        <td>@string.Join(", ", workflow.DefinitionVersions)</td>
                        <td>@string.Join(", ", workflow.Owners)</td>
                        <td>@workflow.OnlineInstanceCount/@workflow.ReportingInstanceCount online</td>
                        <td>@workflow.ObservedRunCount</td>
                        <td><a class="section-link" href="@DefinitionHref(workflow)">View definition →</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<div class="guidance workflow-guidance">
    <strong>One catalog, kind-specific definitions</strong>
    <span>The catalog supports shared discovery and filtering. Each choreography and saga opens on its own page so ownership, evidence, state, and behavior retain the vocabulary of the underlying bus concept.</span>
</div>

@code {
    private static string KindLabel(string kind) => kind == "saga" ? "Saga / orchestration" : "Choreography";

    private static string AuthorityLabel(string authority)
        => authority == "committed_transition_evidence" ? "Committed transition evidence" : "Reconstructed evidence";

    private static string DefinitionHref(MonitoringWorkflowCatalogItem workflow)
        => workflow.Kind == "saga"
            ? $"/workflows/sagas/{Uri.EscapeDataString(workflow.WorkflowId)}"
            : $"/workflows/choreographies/{Uri.EscapeDataString(workflow.WorkflowId)}";
}
