@page "/workflows"
@rendermode InteractiveServer
@inherits MonitoringPageBase

<PageTitle>Declared Workflows · MyServiceBus Monitoring</PageTitle>
<DashboardPageHeader Eyebrow="Coordination" Title="Declared workflows" Description="Explore the choreography that applications explicitly declare: which messages trigger local reactions, what those reactions emit, and which participants may react next." />

<div class="guidance workflow-guidance">
    <strong>Declared intent with bounded evidence</strong>
    <span>
        This map keeps the definition stable and overlays exact causal send and publish counts from the last
        @(Dashboard.ChoreographyRuntime?.WindowSeconds / 60 ?? 5) minutes. No evidence is not a failure or authoritative workflow state.
        @if (Dashboard.ChoreographyRuntime is { Complete: false } coverage)
        {
            <text> Coverage is incomplete: @coverage.DroppedObservations observations were dropped or one or more participants are offline.</text>
        }
    </span>
</div>

@if (Dashboard.Choreographies.Count == 0)
{
    <section class="empty-state">
        <h2>No declared workflows</h2>
        <p>Applications appear here after they register choreography fragments and export monitoring metadata.</p>
    </section>
}
else
{
    @foreach (var choreography in Dashboard.Choreographies)
    {
        <section class="panel workflow-panel">
            <div class="section-heading workflow-heading">
                <div>
                    <p class="eyebrow">Declared choreography</p>
                    <h2>@choreography.ChoreographyId</h2>
                    <div class="workflow-badges">
                        @foreach (var version in choreography.DefinitionVersions)
                        {
                            <span class="pill">Version @version</span>
                        }
                        @foreach (var conflict in choreography.ConflictKinds)
                        {
                            <span class="workflow-conflict">@ConflictLabel(conflict)</span>
                        }
                    </div>
                </div>
                <span>@choreography.Fragments.Count @(choreography.Fragments.Count == 1 ? "participant" : "participants") · captured @choreography.LastCapturedAtUtc.ToLocalTime().ToString("MMM d, HH:mm:ss")</span>
            </div>

            <div class="workflow-map" aria-label="Declared reactions grouped by application">
                @foreach (var fragment in choreography.Fragments)
                {
                    <article class="workflow-participant">
                        <header>
                            <div>
                                <span class="status-dot @(fragment.OnlineInstances > 0 ? "online" : "offline")"></span>
                                <strong>@fragment.ApplicationName</strong>
                                @if (!string.Equals(fragment.ApplicationName, fragment.Owner, StringComparison.Ordinal))
                                {
                                    <small>Owner @fragment.Owner</small>
                                }
                            </div>
                            <span>@fragment.OnlineInstances/@fragment.ReportingInstances online</span>
                        </header>

                        <div class="workflow-reactions">
                            @foreach (var step in fragment.Steps)
                            {
                                <section class="workflow-reaction">
                                    <div class="workflow-step-label">@step.Id</div>
                                    <div class="workflow-trigger">
                                        <small>Consumes</small>
                                        <strong>@ContractLabel(step.TriggerMessageUrn)</strong>
                                        @if (!string.IsNullOrWhiteSpace(step.OwnerComponent))
                                        {
                                            <span>@step.OwnerComponent</span>
                                        }
                                    </div>
                                    <div class="workflow-arrow" aria-hidden="true">→</div>
                                    <div class="workflow-outputs">
                                        @for (var outputIndex = 0; outputIndex < step.Outputs.Count; outputIndex++)
                                        {
                                            var output = step.Outputs[outputIndex];
                                            <div class="workflow-output">
                                                <small>@output.Kind.ToString()</small>
                                                <strong>@OutputLabel(output.MessageUrn)</strong>
                                                <span>@OutputDetail(choreography, fragment, step, output)</span>
                                                @if (RuntimeFor(choreography, fragment, step, outputIndex) is { } runtime)
                                                {
                                                    <span class="workflow-evidence @(runtime.EvidenceStatus == "exact_causation" ? "observed" : null)">
                                                        @(runtime.EvidenceStatus == "exact_causation"
                                                            ? $"Observed {runtime.ObservedCount:N0} times · exact causation"
                                                            : EvidenceLabel(runtime.EvidenceStatus))
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </section>
                            }
                        </div>

                        <footer>Definition @fragment.DefinitionVersion · last reported @fragment.LastCapturedAtUtc.ToLocalTime().ToString("HH:mm:ss")</footer>
                    </article>
                }
            </div>

            @if (RunsFor(choreography.ChoreographyId) is { Length: > 0 } runs)
            {
                var selectedRun = SelectedRun(choreography.ChoreographyId, runs);
                <section class="workflow-runs" aria-label="Reconstructed workflow runs">
                    <div class="workflow-run-heading">
                        <div>
                            <p class="eyebrow">Exact causal evidence</p>
                            <h3>Workflow runs</h3>
                        </div>
                        <span>Live as observations arrive · @runs.Length recent @(runs.Length == 1 ? "run" : "runs")</span>
                    </div>
                    <div class="workflow-run-selector" role="list" aria-label="Select a reconstructed run">
                        @foreach (var run in runs.Take(8))
                        {
                            <button type="button"
                                    class="@(run.RunId == selectedRun.RunId ? "selected" : null)"
                                    @onclick="() => SelectRun(choreography.ChoreographyId, run.RunId)">
                                <span class="run-status @run.Status"></span>
                                <strong>@RunStatus(run.Status)</strong>
                                <small>@run.LastActivityAtUtc.ToLocalTime().ToString("HH:mm:ss") · @run.Steps.Count steps</small>
                            </button>
                        }
                    </div>

                    <div class="workflow-run-summary">
                        <div>
                            <span class="run-status @selectedRun.Status"></span>
                            <strong>@RunStatus(selectedRun.Status)</strong>
                            <small>Reconstructed · @selectedRun.Confidence.Replace('_', ' ')</small>
                        </div>
                        <span>Observed span @FormatDuration(selectedRun.ObservedDurationMs) · last activity @selectedRun.LastActivityAtUtc.ToLocalTime().ToString("HH:mm:ss.fff")</span>
                    </div>

                    <WorkflowRunMap @key="selectedRun.RunId" Run="selectedRun" />

                    <div class="workflow-run-flow" aria-label="Ordered workflow run step evidence">
                        @for (var stepIndex = 0; stepIndex < selectedRun.Steps.Count; stepIndex++)
                        {
                            var step = selectedRun.Steps[stepIndex];
                            @if (stepIndex > 0)
                            {
                                <div class="workflow-run-connector" aria-hidden="true">→</div>
                            }
                            <article class="workflow-run-step @step.Status">
                                <header>
                                    <span>Step @step.Sequence</span>
                                    <strong>@step.ApplicationName</strong>
                                    <small>@step.StartedAtUtc.ToLocalTime().ToString("HH:mm:ss.fff")</small>
                                </header>
                                <div class="workflow-run-step-body">
                                    <span class="workflow-run-contract">Consumes <strong>@ContractLabel(step.TriggerMessageUrn)</strong></span>
                                    <h4>@step.StepId</h4>
                                    <p>@(step.OwnerComponent ?? step.EndpointName ?? step.Owner)</p>
                                    <dl>
                                        <div><dt>Handler</dt><dd>@FormatDuration(step.DurationMs)</dd></div>
                                        <div><dt>Outcome</dt><dd>@DisplayKind(step.Status)</dd></div>
                                        @if (step.RetryCount > 0)
                                        {
                                            <div><dt>Retries</dt><dd>@step.RetryCount</dd></div>
                                        }
                                    </dl>
                                    @if (!string.IsNullOrWhiteSpace(step.FailureType))
                                    {
                                        <div class="workflow-run-failure">@ContractLabel(step.FailureType)</div>
                                    }
                                    @foreach (var output in step.Outputs)
                                    {
                                        <div class="workflow-run-output @(output.Succeeded ? null : "faulted")">
                                            <span>@DisplayKind(output.OperationKind)</span>
                                            <strong>@OutputLabel(output.MessageUrn)</strong>
                                            <small>@FormatDuration(output.DurationMs)</small>
                                            @foreach (var target in output.Targets)
                                            {
                                                <em>Handoff @FormatDuration(target.HandoffDurationMs) → @TargetLabel(selectedRun, target.StepKey)</em>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(output.FailureType))
                                            {
                                                <em>@ContractLabel(output.FailureType)</em>
                                            }
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                    <footer>
                        Run identity @Abbreviate(selectedRun.RootMessageId) · this is a bounded reconstruction, not authoritative workflow state.
                    </footer>
                </section>
            }
        </section>
    }
}

@code {
    private readonly Dictionary<string, string> selectedRunIds = new(StringComparer.Ordinal);

    private static string ConflictLabel(string conflict) => conflict switch
    {
        "definition_version" => "Version conflict",
        "step_ownership" => "Step ownership conflict",
        "owner" => "Owner conflict",
        _ => DisplayKind(conflict)
    };

    private static string OutputLabel(string? messageUrn)
        => string.IsNullOrWhiteSpace(messageUrn) ? "Terminal" : ContractLabel(messageUrn);

    private static string ContractLabel(string value) => value.Split('.', ':').Last();

    private static string OutputDetail(
        MonitoringDeclaredChoreography choreography,
        MonitoringDeclaredChoreographyFragment sourceFragment,
        MyServiceBus.Choreography.ChoreographyStep sourceStep,
        MyServiceBus.Choreography.ChoreographyOutput output)
    {
        var details = new List<string>();
        if (!string.IsNullOrWhiteSpace(output.Destination))
            details.Add(output.Destination);

        var targets = choreography.Connections
            .Where(connection => string.Equals(connection.DefinitionVersion, sourceFragment.DefinitionVersion, StringComparison.Ordinal)
                && string.Equals(connection.SourceApplication, sourceFragment.ApplicationName, StringComparison.Ordinal)
                && string.Equals(connection.SourceOwner, sourceFragment.Owner, StringComparison.Ordinal)
                && string.Equals(connection.SourceStepId, sourceStep.Id, StringComparison.Ordinal)
                && connection.OperationKind == output.Kind
                && string.Equals(connection.MessageUrn, output.MessageUrn, StringComparison.Ordinal)
                && string.Equals(connection.Destination, output.Destination, StringComparison.Ordinal))
            .Select(connection => connection.TargetApplication)
            .Distinct(StringComparer.Ordinal)
            .OrderBy(application => application, StringComparer.Ordinal)
            .ToArray();
        if (targets.Length > 0)
            details.Add($"declared next: {string.Join(", ", targets)}");

        details.Add(output.Requirement.ToString().ToLowerInvariant());
        if (output.MinCount == output.MaxCount && output.MinCount.HasValue)
            details.Add($"exactly {output.MinCount}");
        else
        {
            if (output.MinCount.HasValue)
                details.Add($"at least {output.MinCount}");
            if (output.MaxCount.HasValue)
                details.Add($"at most {output.MaxCount}");
        }
        if (output.WithinMilliseconds.HasValue)
            details.Add($"within {TimeSpan.FromMilliseconds(output.WithinMilliseconds.Value):g}");
        return string.Join(" · ", details);
    }

    private MonitoringChoreographyReactionRuntime? RuntimeFor(
        MonitoringDeclaredChoreography choreography,
        MonitoringDeclaredChoreographyFragment fragment,
        MyServiceBus.Choreography.ChoreographyStep step,
        int outputIndex)
    {
        return Dashboard.ChoreographyRuntime?.Reactions.FirstOrDefault(reaction =>
            string.Equals(reaction.ChoreographyId, choreography.ChoreographyId, StringComparison.Ordinal)
            && string.Equals(reaction.DefinitionVersion, fragment.DefinitionVersion, StringComparison.Ordinal)
            && string.Equals(reaction.ApplicationName, fragment.ApplicationName, StringComparison.Ordinal)
            && string.Equals(reaction.Owner, fragment.Owner, StringComparison.Ordinal)
            && string.Equals(reaction.StepId, step.Id, StringComparison.Ordinal)
            && reaction.OutputIndex == outputIndex);
    }

    private static string EvidenceLabel(string status) => status switch
    {
        "no_exact_evidence" => "No exact evidence in this window",
        "ambiguous_declaration" => "Declaration match is ambiguous",
        "unsupported_operation" => "Runtime evidence not supported yet",
        _ => DisplayKind(status)
    };

    private MonitoringChoreographyRun[] RunsFor(string choreographyId)
        => Dashboard.ChoreographyRuns?.Runs
            .Where(run => string.Equals(run.ChoreographyId, choreographyId, StringComparison.Ordinal))
            .OrderByDescending(run => run.LastActivityAtUtc)
            .ToArray()
            ?? [];

    private MonitoringChoreographyRun SelectedRun(
        string choreographyId,
        IReadOnlyList<MonitoringChoreographyRun> runs)
    {
        if (selectedRunIds.TryGetValue(choreographyId, out var runId))
            return runs.FirstOrDefault(run => string.Equals(run.RunId, runId, StringComparison.Ordinal)) ?? runs[0];
        return runs[0];
    }

    private void SelectRun(string choreographyId, string runId)
        => selectedRunIds[choreographyId] = runId;

    private static string RunStatus(string status) => status switch
    {
        "live" => "Live activity",
        "terminal_observed" => "Terminal observed",
        "faulted" => "Fault evidence",
        "no_recent_activity" => "No recent activity",
        _ => DisplayKind(status)
    };

    private static string FormatDuration(double milliseconds)
        => milliseconds >= 1_000
            ? $"{milliseconds / 1_000:0.##} s"
            : $"{milliseconds:0.##} ms";

    private static string TargetLabel(MonitoringChoreographyRun run, string stepKey)
    {
        var target = run.Steps.FirstOrDefault(step => string.Equals(step.StepKey, stepKey, StringComparison.Ordinal));
        return target is null ? "next step" : $"{target.ApplicationName}/{target.StepId}";
    }

    private static string Abbreviate(string value)
        => value.Length <= 12 ? value : $"{value[..8]}…{value[^4..]}";
}
