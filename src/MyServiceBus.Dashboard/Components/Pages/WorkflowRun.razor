@page "/workflows/runs/{RunId}"
@rendermode InteractiveServer
@inherits MonitoringPageBase
@inject MonitoringApiClient Api

<PageTitle>Workflow Run · MyServiceBus Monitoring</PageTitle>
<DashboardPageHeader Eyebrow="Coordination" Title="Workflow run" Description="Inspect one reconstructed coordination run, its causal message path, handler timing, and localized failures." />
<WorkflowTabs Active="runs" />

@if (loadingRun)
{
    <section class="empty-state"><h2>Loading workflow run</h2></section>
}
else if (SelectedRun is not { } run)
{
    <section class="empty-state">
        <h2>Workflow run not available</h2>
        <p>This run is outside the monitoring service's configured retention window, or its identity is no longer present.</p>
        <a class="section-link" href="/workflows">← Back to workflow runs</a>
    </section>
}
else
{
    <div class="workflow-run-breadcrumb"><a href="/workflows">Workflow runs</a><span>→</span><strong>@run.ChoreographyId</strong></div>

    <section class="panel workflow-run-detail">
        <div class="workflow-run-outcome @run.Status" role="status">
            <span class="run-status @run.Status"></span>
            <div>
                <p class="eyebrow">@CoordinationType(run.CoordinationType)</p>
                <h2>@OutcomeTitle(run.Status)</h2>
                <p>@OutcomeDescription(run.Status)</p>
            </div>
            <dl>
                <div><dt>Workflow</dt><dd>@run.ChoreographyId</dd></div>
                <div><dt>Run</dt><dd>@Abbreviate(run.RootMessageId)</dd></div>
                <div><dt>Observed span</dt><dd>@FormatDuration(run.ObservedDurationMs)</dd></div>
                <div><dt>Steps</dt><dd>@run.Steps.Count</dd></div>
                <div><dt>Observed shape</dt><dd>@ShapeLabel(run)</dd></div>
                <div><dt>Exact roots</dt><dd>@run.RootCount</dd></div>
            </dl>
        </div>

        <div class="workflow-run-summary">
            <div>
                <span class="run-status @run.Status"></span>
                <strong>@RunStatus(run.Status)</strong>
                <small>Reconstructed · @run.Confidence.Replace('_', ' ') · @ShapeLabel(run)@DiagnosticSummary(run)</small>
            </div>
            <span>Started @run.StartedAtUtc.ToLocalTime().ToString("MMM d, HH:mm:ss.fff") · last activity @run.LastActivityAtUtc.ToLocalTime().ToString("HH:mm:ss.fff")</span>
        </div>

        @if (!run.EvidenceComplete)
        {
            <div class="workflow-run-coverage-warning">
                Evidence is incomplete: @run.DroppedObservations observations were dropped or one or more declared participants were offline when this run was captured.
            </div>
        }

        @if (run.DiagnosticIssueCount > 0)
        {
            <div class="workflow-run-diagnostic-warning">
                <strong>@run.DiagnosticIssueCount declared/observed @(run.DiagnosticIssueCount == 1 ? "finding" : "findings")</strong>
                <span>These findings compare local declarations with exact monitoring evidence. They are operational diagnostics, not proof that the business workflow failed.</span>
            </div>
        }
        @if (run.IndeterminateExpectationCount > 0)
        {
            <div class="workflow-run-structure-note">
                @run.IndeterminateExpectationCount output @(run.IndeterminateExpectationCount == 1 ? "expectation is" : "expectations are") pending, unsupported, or inconclusive because of evidence coverage.
            </div>
        }

        @if (run.ObservedShape != "linear")
        {
            <div class="workflow-run-structure-note">
                The graph contains @StructureDescription(run). The cards below remain chronological; exact handoff labels and graph edges define causation. Observed convergence does not by itself prove a declared business join.
            </div>
        }

        <WorkflowRunMap @key="run.RunId" Run="run" />

        <div class="workflow-run-flow" aria-label="Chronological workflow run step evidence">
            @for (var stepIndex = 0; stepIndex < run.Steps.Count; stepIndex++)
            {
                var step = run.Steps[stepIndex];
                @if (stepIndex > 0)
                {
                    <div class="workflow-run-connector" aria-hidden="true">@(run.ObservedShape == "linear" ? "→" : "⋯")</div>
                }
                <article class="workflow-run-step @step.Status">
                    <header>
                        <span>Step @step.Sequence</span>
                        <strong>@step.ApplicationName</strong>
                        <small>@step.StartedAtUtc.ToLocalTime().ToString("HH:mm:ss.fff")</small>
                    </header>
                    <div class="workflow-run-step-body">
                        <span class="workflow-run-contract">Consumes <strong>@ContractLabel(step.TriggerMessageUrn)</strong></span>
                        <h4>@step.StepId</h4>
                        <p>@(step.OwnerComponent ?? step.EndpointName ?? step.Owner)</p>
                        <dl>
                            <div><dt>Handler</dt><dd>@FormatDuration(step.DurationMs)</dd></div>
                            <div><dt>Outcome</dt><dd>@DisplayKind(step.Status)</dd></div>
                            @if (step.RetryCount > 0)
                            {
                                <div><dt>Retries</dt><dd>@step.RetryCount</dd></div>
                            }
                        </dl>
                        @if (!string.IsNullOrWhiteSpace(step.FailureType))
                        {
                            <div class="workflow-run-failure">@ContractLabel(step.FailureType)</div>
                        }
                        @foreach (var output in step.Outputs)
                        {
                            <div class="workflow-run-output @(output.Succeeded ? null : "faulted")">
                                <span>@DisplayKind(output.OperationKind)</span>
                                <strong>@OutputLabel(output.MessageUrn)</strong>
                                <small>@FormatDuration(output.DurationMs)</small>
                                @foreach (var target in output.Targets)
                                {
                                    <em>Handoff @FormatDuration(target.HandoffDurationMs) → @TargetLabel(run, target.StepKey)</em>
                                }
                                @if (!string.IsNullOrWhiteSpace(output.FailureType))
                                {
                                    <em>@ContractLabel(output.FailureType)</em>
                                }
                            </div>
                        }
                        @if (step.OutputExpectations.Count > 0)
                        {
                            <div class="workflow-run-expectations">
                                <span class="workflow-run-expectations-label">Declared output comparison</span>
                                @foreach (var expectation in step.OutputExpectations)
                                {
                                    <div class="workflow-run-expectation @expectation.Status">
                                        <span>@DisplayKind(expectation.OperationKind)</span>
                                        <strong>@OutputLabel(expectation.MessageUrn)</strong>
                                        <em>@ExpectationStatus(expectation.Status)</em>
                                        <small>@ExpectationSummary(expectation)</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
        <footer>Run identity @run.RootMessageId@if (run.RootCount > 1) {<text> · @run.RootCount exactly connected roots</text>} · this is a bounded reconstruction, not authoritative workflow state.</footer>
    </section>
}

@code {
    [Parameter]
    public string RunId { get; set; } = string.Empty;

    private MonitoringChoreographyRun? loadedRun;
    private bool loadingRun = true;

    protected override async Task OnParametersSetAsync()
    {
        loadingRun = true;
        try
        {
            loadedRun = await Api.GetWorkflowRun(Uri.UnescapeDataString(RunId), CancellationToken.None);
        }
        finally
        {
            loadingRun = false;
        }
    }

    private MonitoringChoreographyRun? SelectedRun
    {
        get
        {
            var decoded = Uri.UnescapeDataString(RunId);
            return Dashboard.WorkflowRuns?.Runs.FirstOrDefault(run =>
                string.Equals(run.RunId, decoded, StringComparison.Ordinal)) ?? loadedRun;
        }
    }

    private static string CoordinationType(string type) => type switch
    {
        "choreography" => "Choreography",
        "orchestration" => "Orchestration / Saga",
        _ => DisplayKind(type)
    };

    private static string OutcomeTitle(string status) => status switch
    {
        "faulted" => "Workflow failed",
        "terminal_observed" => "Terminal activity observed",
        "live" => "Workflow activity is live",
        "no_recent_activity" => "No recent workflow activity",
        _ => DisplayKind(status)
    };

    private static string OutcomeDescription(string status) => status switch
    {
        "faulted" => "At least one observed consumer or outgoing message operation failed in this run.",
        "terminal_observed" => "A declared terminal reaction completed successfully in the observed message path.",
        "live" => "New evidence may still extend this reconstructed message path.",
        "no_recent_activity" => "The observed path has not changed recently and no terminal reaction was seen.",
        _ => "The monitoring service reconstructed this outcome from exact causal evidence."
    };

    private static string RunStatus(string status) => status switch
    {
        "live" => "Live activity",
        "terminal_observed" => "Terminal observed",
        "faulted" => "Failed",
        "no_recent_activity" => "No recent activity",
        _ => DisplayKind(status)
    };

    private static string OutputLabel(string? messageUrn)
        => string.IsNullOrWhiteSpace(messageUrn) ? "Terminal" : ContractLabel(messageUrn);

    private static string ContractLabel(string value) => value.Split('.', ':').Last();

    private static string FormatDuration(double milliseconds)
        => milliseconds >= 1_000 ? $"{milliseconds / 1_000:0.##} s" : $"{milliseconds:0.##} ms";

    private static string ShapeLabel(MonitoringChoreographyRun run) => run.ObservedShape switch
    {
        "branching" => "Branching",
        "converging" => "Converging",
        "branching_and_converging" => "Branching + converging",
        _ => "Linear"
    };

    private static string StructureDescription(MonitoringChoreographyRun run)
    {
        var parts = new List<string>();
        if (run.BranchPointCount > 0)
            parts.Add($"{run.BranchPointCount} exact fan-out point{(run.BranchPointCount == 1 ? string.Empty : "s")}");
        if (run.MergePointCount > 0)
            parts.Add($"{run.MergePointCount} exact convergence point{(run.MergePointCount == 1 ? string.Empty : "s")}");
        return string.Join(" and ", parts);
    }

    private static string DiagnosticSummary(MonitoringChoreographyRun run)
        => run.DiagnosticIssueCount > 0
            ? $" · {run.DiagnosticIssueCount} comparison {(run.DiagnosticIssueCount == 1 ? "finding" : "findings")}"
            : run.IndeterminateExpectationCount > 0
                ? $" · {run.IndeterminateExpectationCount} inconclusive"
                : string.Empty;

    private static string ExpectationStatus(string status) => status switch
    {
        "exact_observed" => "Observed as declared",
        "awaiting_evidence" => "Awaiting evidence",
        "insufficient_evidence" => "Evidence incomplete",
        "missing_expected" => "Expected output not observed",
        "below_minimum" => "Below declared minimum",
        "above_maximum" => "Above declared maximum",
        "timing_exceeded" => "Outside declared timing",
        "unexpected_observed" => "Undeclared output observed",
        "output_faulted" => "Output operation faulted",
        "optional_not_observed" => "Optional · not observed",
        "informational_not_observed" => "Informational · not observed",
        "expectation_satisfied" => "Satisfied · no output required",
        "unsupported_operation" => "Comparison not supported",
        _ => DisplayKind(status)
    };

    private static string ExpectationSummary(MonitoringChoreographyRunOutputExpectation expectation)
    {
        var parts = new List<string> { $"Observed {expectation.ObservedCount}" };
        if (expectation.MinimumCount is { } minimum)
            parts.Add($"minimum {minimum}");
        if (expectation.MaximumCount is { } maximum)
            parts.Add($"maximum {maximum}");
        if (expectation.WithinMilliseconds is { } within)
            parts.Add($"within {FormatDuration(within)}");
        if (expectation.FailedCount > 0)
            parts.Add($"{expectation.FailedCount} faulted");
        if (expectation.LateCount > 0)
            parts.Add($"{expectation.LateCount} late");
        if (expectation.Requirement != "undeclared")
            parts.Add(expectation.Requirement);
        return string.Join(" · ", parts);
    }

    private static string TargetLabel(MonitoringChoreographyRun run, string stepKey)
    {
        var target = run.Steps.FirstOrDefault(step => string.Equals(step.StepKey, stepKey, StringComparison.Ordinal));
        return target is null ? "next step" : $"{target.ApplicationName}/{target.StepId}";
    }

    private static string Abbreviate(string value)
        => value.Length <= 12 ? value : $"{value[..8]}…{value[^4..]}";
}
