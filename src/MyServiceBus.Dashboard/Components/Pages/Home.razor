@page "/"
@rendermode InteractiveServer
@inherits MonitoringPageBase

<PageTitle>MyServiceBus Monitoring</PageTitle>

<section class="hero">
    <div>
        <p class="eyebrow">Distributed messaging</p>
        <h1>Operational overview</h1>
        <p class="lede">The current health and activity of every participating MyServiceBus application.</p>
    </div>
    <div class="connection @(Dashboard.Error is null ? "online" : "offline")">
        <span></span>
        @(Dashboard.Error is not null ? "Monitoring service unavailable" : Dashboard.LiveConnected ? "Live updates connected" : "Polling monitoring service")
    </div>
</section>

@if (Dashboard.Applications.Count == 0)
{
    <section class="empty-state">
        <h2>Waiting for applications</h2>
        <p>Start an application with the monitoring exporter enabled. Its replicas will register automatically.</p>
    </section>
}
else
{
    <section class="overview-grid dashboard-widget" data-widget-id="summary" aria-label="Operational summary">
        <MetricValue Label="Applications" Value="@Dashboard.Applications.Count.ToString("N0")" />
        <MetricValue Label="Replicas online" Value="@($"{OnlineInstances:N0} / {TotalInstances:N0}")" Alert="@(OnlineInstances < TotalInstances)" />
        <MetricValue Label="Messages handled / sec" Value="@FormatRate(TotalConsumedRate)" />
        <MetricValue Label="Failures · 60 sec" Value="@WindowFailures.ToString("N0")" Alert="@(WindowFailures > 0)" />
        <MetricValue Label="Monitoring data" Value="@(CompleteCoverage ? "Complete" : "Incomplete")" Alert="@(!CompleteCoverage)" />
    </section>

    <div class="overview-detail-grid">
        <section class="panel overview-panel dashboard-widget" data-widget-id="throughput">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Live throughput</p>
                    <h2>Messages handled per second</h2>
                </div>
                <a class="section-link" href="/throughput">View details</a>
            </div>
            <ThroughputChart Points="Dashboard.TimeSeries" Compact="true" />
        </section>

        <section class="panel overview-panel dashboard-widget" data-widget-id="attention">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Attention</p>
                    <h2>Current concerns</h2>
                </div>
                <a class="section-link" href="/failures">Open failures</a>
            </div>
            @if (AttentionApplications.Count == 0)
            {
                <div class="healthy-state">
                    <span class="status-dot online"></span>
                    <div>
                        <strong>No application needs attention</strong>
                        <p>All replicas are online and no failures or retries were observed in the current window.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="attention-list">
                    @foreach (var application in AttentionApplications.Take(5))
                    {
                        var rate = ApplicationRate(application.ApplicationName);
                        <div class="attention-row">
                            <span class="status-dot @(application.OnlineInstances == application.TotalInstances ? "online" : "offline")"></span>
                            <strong>@application.ApplicationName</strong>
                            <span>@application.OnlineInstances / @application.TotalInstances replicas</span>
                            <span class="@(Failures(rate?.Counts) > 0 ? "fault" : null)">@Failures(rate?.Counts).ToString("N0") failures</span>
                        </div>
                    }
                </div>
            }
        </section>
    </div>

    <nav class="drilldown-grid dashboard-widget" data-widget-id="drilldowns" aria-label="Operational detail views">
        <a href="/applications"><strong>Applications</strong><span>Replicas, versions, labels, and transport context</span></a>
        <a href="/flow"><strong>Message flow</strong><span>Live topology map and observed paths</span></a>
        <a href="/failures"><strong>Failures</strong><span>Retries, terminal failures, and correlation detail</span></a>
        <a href="/outbox"><strong>Outbox</strong><span>Dispatcher backlog, delivery, leases, and latency</span></a>
    </nav>
}

@code {
    private int OnlineInstances => Dashboard.Applications.Sum(application => application.OnlineInstances);
    private int TotalInstances => Dashboard.Applications.Sum(application => application.TotalInstances);
    private double TotalConsumedRate => Dashboard.ApplicationRates.Sum(rate => rate.Rates.ConsumedPerSecond);
    private long WindowFailures => Dashboard.ApplicationRates.Sum(rate => Failures(rate.Counts));
    private bool CompleteCoverage => Dashboard.ApplicationRates.Count > 0 && Dashboard.ApplicationRates.All(rate => rate.Complete);

    private IReadOnlyList<MonitoringApplicationSummary> AttentionApplications
        => Dashboard.Applications.Where(application =>
        {
            var rate = ApplicationRate(application.ApplicationName);
            return application.OnlineInstances < application.TotalInstances
                || Failures(rate?.Counts) > 0
                || rate?.Counts.RetryAttempted > 0
                || rate is { Complete: false };
        }).ToArray();

    private MonitoringRateSummary? ApplicationRate(string applicationName)
        => Dashboard.ApplicationRates.FirstOrDefault(rate => rate.ApplicationName == applicationName);
}
