@page "/applications/{ApplicationName}/flow"
@rendermode InteractiveServer
@inherits ApplicationPageBase

<PageTitle>@ApplicationName flow · MyServiceBus Monitoring</PageTitle>
<DashboardPageHeader Eyebrow="Application flow" Title="@ApplicationName" Description="Follow the messages entering and leaving this application, including the exact replicas that reported each observed path." />
<ApplicationNavigation ApplicationName="@ApplicationName" />

@if (Application is null)
{
    <section class="empty-state"><h2>Application not found</h2><p>This application may not have registered yet, or its monitoring lease may have expired.</p></section>
}
else
{
    <section class="panel flow-map-panel application-flow-map">
        <div class="section-heading"><div><p class="eyebrow">Live neighborhood</p><h2>Direct replica flow</h2></div><span>Last 5 minutes · line width represents throughput</span></div>
        <ReplicaFlowMap Instances="ReplicaFlowInstances" Edges="ApplicationReplicaFlow" FocusApplication="@ApplicationName" />
        <p class="map-help">All replicas of this application are grouped together, with the directly observed replicas of neighboring applications. Drag a replica to explore; scroll or use the controls to zoom.</p>
    </section>

    <section class="panel flow-detail-panel">
        <div class="section-heading"><div><p class="eyebrow">Exact paths</p><h2>Observed connections</h2></div><span>Last 5 minutes</span></div>
        @if (ApplicationReplicaFlow.Count == 0)
        {
            <p class="panel-empty">No correlated message paths were observed for this application in this window.</p>
        }
        else
        {
            <div class="flow-list">
                @foreach (var edge in ApplicationReplicaFlow.OrderByDescending(edge => edge.Count))
                {
                    <div class="flow-edge replica-flow-edge">
                        <strong>@edge.SourceApplication <small>@edge.SourceInstanceId</small></strong>
                        <span>→</span>
                        <strong>@edge.TargetApplication <small>@edge.TargetInstanceId</small></strong>
                        <small>@ShortMessageType(edge.MessageType) · @edge.Count.ToString("N0") @(edge.Count == 1 ? "message" : "messages")</small>
                    </div>
                }
            </div>
        }
    </section>
}
