@page "/flow"
@rendermode InteractiveServer
@inherits MonitoringPageBase

<PageTitle>Message Flow · MyServiceBus Monitoring</PageTitle>
<DashboardPageHeader Eyebrow="System map" Title="Message flow" Description="Explore which applications exchange messages and the observed traffic between them. This map is reconstructed from recent correlated activity." />

<section class="overview-grid flow-summary-grid">
    <MetricValue Label="Applications exchanging messages" Value="@ObservedApplicationCount.ToString("N0")" />
    <MetricValue Label="Application relationships" Value="@ApplicationRelationships.Count.ToString("N0")" />
    <MetricValue Label="Message paths" Value="@Dashboard.Flow.Count.ToString("N0")" />
    <MetricValue Label="Messages · 5 min" Value="@Dashboard.Flow.Sum(edge => edge.Count).ToString("N0")" />
</section>

<section class="panel flow-map-panel">
    <div class="section-heading flow-map-heading">
        <div><p class="eyebrow">Live system map</p><h2>@(_view == FlowView.Applications ? "Observed application flow" : "Replica flow by application")</h2></div>
        <div class="flow-view-options">
            <span>Last 5 minutes · line width represents throughput</span>
            <div class="flow-view-toggle" role="group" aria-label="Message flow detail level">
                <button type="button" class="@ViewClass(FlowView.Applications)" aria-pressed="@(_view == FlowView.Applications)" @onclick="() => _view = FlowView.Applications">Applications</button>
                <button type="button" class="@ViewClass(FlowView.Replicas)" aria-pressed="@(_view == FlowView.Replicas)" @onclick="() => _view = FlowView.Replicas">Detailed</button>
            </div>
        </div>
    </div>
    @if (_view == FlowView.Applications)
    {
        <FlowMap Applications="Dashboard.Applications" Edges="Dashboard.Flow" />
        <p class="map-help">Drag applications to explore the topology. Select one to focus its direct message paths; scroll or use the controls to zoom.</p>
    }
    else
    {
        <ReplicaFlowMap Instances="Dashboard.Instances" Edges="Dashboard.ReplicaFlow" />
        <p class="map-help">Each boundary is an application and each node is a running or recently observed replica. Paths show which exact producer and consumer replicas reported the correlated message flow.</p>
    }
</section>

<section class="panel request-response-panel">
    <div class="section-heading">
        <div><p class="eyebrow">Paired interactions</p><h2>Request / response</h2></div>
        <span>Explicit request identity · last 5 minutes</span>
    </div>
    @if (Dashboard.RequestResponseExchanges.Count == 0)
    {
        <p class="panel-empty">No request/response exchanges were captured in this window. Detailed pairing is available when request/response metadata is enabled by the monitored service.</p>
    }
    else
    {
        <div class="request-response-list">
            @foreach (var exchange in Dashboard.RequestResponseExchanges)
            {
                <article class="request-response-exchange @(exchange.HasFailures ? "failed" : exchange.Status)">
                    <header>
                        <div><span class="run-status @(exchange.HasFailures ? "failed" : exchange.Status)"></span><strong>@StatusLabel(exchange.Status)</strong><small class="mono">@ShortIdentity(exchange.RequestId)</small></div>
                        <span>@FormatDuration(exchange.DurationMs)</span>
                    </header>
                    <div class="request-response-route">
                        <div class="request-response-participant"><strong>@exchange.RequesterApplication</strong><small>@exchange.RequesterInstanceId</small></div>
                        <div class="request-response-messages" aria-label="Request and response messages">
                            <div><span>@ShortMessageType(exchange.RequestMessageType)</span><b>→</b></div>
                            <div class="response"><b>←</b><span>@(exchange.ResponseMessageType is null ? "Awaiting response" : ShortMessageType(exchange.ResponseMessageType))</span></div>
                        </div>
                        <div class="request-response-participant"><strong>@(exchange.ResponderApplication ?? "Awaiting responder")</strong><small>@(exchange.ResponderInstanceId ?? "No consumer evidence")</small></div>
                    </div>
                    <footer><span>Requested @exchange.StartedAtUtc.LocalDateTime.ToString("HH:mm:ss.fff")</span><span>@EvidenceLabel(exchange)</span><a href="@($"/request-response/{Uri.EscapeDataString(exchange.RequestId)}")">Inspect exchange →</a></footer>
                </article>
            }
        </div>
    }
</section>

<section class="panel flow-detail-panel">
    <div class="section-heading"><div><p class="eyebrow">Exact paths</p><h2>@(_view == FlowView.Applications ? "Observed connections" : "Observed replica connections")</h2></div><span>Last 5 minutes</span></div>
    @if ((_view == FlowView.Applications && Dashboard.Flow.Count == 0)
        || (_view == FlowView.Replicas && Dashboard.ReplicaFlow.Count == 0))
    {
        <p class="panel-empty">No correlated message paths were observed in this window.</p>
    }
    else if (_view == FlowView.Applications)
    {
        <div class="flow-relationship-list">
            @foreach (var relationship in ApplicationRelationships)
            {
                <article class="flow-relationship">
                    <header>
                        <div class="flow-relationship-route">
                            <strong>@relationship.SourceApplication</strong>
                            <span>→</span>
                            <strong>@relationship.TargetApplication</strong>
                            <em>@(relationship.Internal ? "Internal" : "Cross-application")</em>
                        </div>
                        <div><strong>@relationship.MessageCount.ToString("N0")</strong><small>@relationship.Paths.Count path@(relationship.Paths.Count == 1 ? null : "s")</small></div>
                    </header>
                    <div class="flow-relationship-paths">
                        @foreach (var path in relationship.Paths)
                        {
                            <div><strong>@path.Message</strong><span>@DisplayKind(path.OperationKind)</span><small>@path.Count.ToString("N0") @(path.Count == 1 ? "message" : "messages")</small></div>
                        }
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="flow-list">
            @foreach (var edge in Dashboard.ReplicaFlow)
            {
                <div class="flow-edge replica-flow-edge">
                    <strong>@edge.SourceApplication <small>@edge.SourceInstanceId</small></strong>
                    <span>→</span>
                    <strong>@edge.TargetApplication <small>@edge.TargetInstanceId</small></strong>
                    <small>@ShortMessageType(edge.MessageType) · @edge.Count.ToString("N0") @(edge.Count == 1 ? "message" : "messages")</small>
                </div>
            }
        </div>
    }
</section>

@code {
    private FlowView _view = FlowView.Applications;

    private IReadOnlyList<ApplicationRelationship> ApplicationRelationships
        => Dashboard.Flow
            .GroupBy(edge => (edge.SourceApplication, edge.TargetApplication))
            .Select(group => new ApplicationRelationship(
                group.Key.SourceApplication,
                group.Key.TargetApplication,
                string.Equals(group.Key.SourceApplication, group.Key.TargetApplication, StringComparison.Ordinal),
                group.Sum(edge => edge.Count),
                group.GroupBy(edge => (edge.MessageType, edge.OperationKind))
                    .Select(paths => new RelationshipPath(
                        ShortMessageType(paths.Key.MessageType),
                        paths.Key.OperationKind,
                        paths.Sum(edge => edge.Count)))
                    .OrderByDescending(path => path.Count)
                    .ThenBy(path => path.Message, StringComparer.Ordinal)
                    .ToArray()))
            .OrderByDescending(relationship => relationship.MessageCount)
            .ThenBy(relationship => relationship.SourceApplication, StringComparer.Ordinal)
            .ThenBy(relationship => relationship.TargetApplication, StringComparer.Ordinal)
            .ToArray();

    private int ObservedApplicationCount => Dashboard.Flow
        .SelectMany(edge => new[] { edge.SourceApplication, edge.TargetApplication })
        .Distinct(StringComparer.Ordinal)
        .Count();

    private string ViewClass(FlowView view) => _view == view ? "active" : string.Empty;

    private static string StatusLabel(string status) => status switch
    {
        "completed" => "Completed round trip",
        "response_sent" => "Response sent",
        "processing" => "Processing request",
        "failed" => "Failed exchange",
        _ => "Request sent"
    };

    private static string EvidenceLabel(MonitoringRequestResponseExchange exchange) => exchange.Status switch
    {
        "completed" => $"Response received {exchange.ResponseConsumedAtUtc?.LocalDateTime:HH:mm:ss.fff}",
        "response_sent" => $"Response sent {exchange.ResponseSentAtUtc?.LocalDateTime:HH:mm:ss.fff}",
        "processing" => $"Request consumed {exchange.RequestConsumedAtUtc?.LocalDateTime:HH:mm:ss.fff}",
        "failed" => "Failure evidence observed",
        _ => "Awaiting consumer evidence"
    };

    private static string ShortIdentity(string value) => value.Length <= 12 ? value : value[..8];

    private enum FlowView
    {
        Applications,
        Replicas
    }

    private sealed record ApplicationRelationship(
        string SourceApplication,
        string TargetApplication,
        bool Internal,
        long MessageCount,
        IReadOnlyList<RelationshipPath> Paths);

    private sealed record RelationshipPath(string Message, string OperationKind, long Count);
}
