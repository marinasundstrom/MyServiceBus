@inherits LayoutComponentBase
@implements IDisposable
@inject MonitoringDashboardState Dashboard

<div class="app-shell">
    <a class="skip-link" href="#main-content">Skip to dashboard content</a>
    <aside class="sidebar">
        <a class="sidebar-brand" href="/" aria-label="MyServiceBus monitoring overview">
            <span class="brand-mark">MSB</span>
            <span>
                <strong>MyServiceBus</strong>
                <small>Monitoring</small>
            </span>
        </a>

        <nav aria-label="Dashboard sections">
            <span class="nav-label">Operations</span>
            <NavLink href="/" Match="NavLinkMatch.All">Overview</NavLink>
            <span class="nav-label">Explore</span>
            <NavLink href="/applications">Applications</NavLink>
            <NavLink href="/endpoints">Endpoints</NavLink>
            <NavLink href="/throughput">Throughput</NavLink>
            <NavLink href="/flow">Message flow</NavLink>
            <NavLink href="/workflows">Workflows</NavLink>
            <span class="nav-label">Reliability</span>
            <NavLink href="/failures">
                <span>Failures</span>
                @if (FailureCount > 0)
                {
                    <span class="nav-badge" title="@FailureBadgeTitle" aria-label="@FailureBadgeTitle">@FailureBadgeText</span>
                }
            </NavLink>
            <NavLink href="/outbox">Outbox</NavLink>
            <NavLink href="/scheduled">Scheduled work</NavLink>
            <NavLink href="/recurring">Recurring jobs</NavLink>
            <NavLink href="/jobs">Tracked jobs</NavLink>
        </nav>

        <p class="sidebar-note">Understand and operate distributed applications through live messaging topology and activity.</p>
    </aside>

    <div class="content-shell">
        <header class="topbar">
            <div class="topbar-status">
                <span class="status-dot @ConnectionClass"></span>
                <div>
                    <strong role="status" aria-live="polite">@ConnectionTitle</strong>
                    <span>@ConnectionDetail</span>
                </div>
            </div>
            <ThemeSelector />
            <DensitySelector />
        </header>

        <main id="main-content" tabindex="-1">
            @Body
        </main>
    </div>
</div>

@code {
    private long FailureCount => Dashboard.Summary?.FailureCount ?? 0;
    private string FailureBadgeText => FailureCount > 99 ? "99+" : FailureCount.ToString();
    private string ConnectionClass => Dashboard.Error is null ? "online" : string.Empty;
    private string ConnectionTitle => Dashboard.Error is not null
        ? "Monitoring unavailable"
        : Dashboard.LiveConnected ? "Live monitoring" : "Monitoring by polling";
    private string ConnectionDetail => Dashboard.Error is not null
        ? $"Last data {Dashboard.UpdatedAt.ToLocalTime():HH:mm:ss}"
        : Dashboard.LiveConnected
            ? $"Updated {Dashboard.UpdatedAt.ToLocalTime():HH:mm:ss}"
            : $"Every 15 seconds · updated {Dashboard.UpdatedAt.ToLocalTime():HH:mm:ss}";

    private string FailureBadgeTitle
    {
        get
        {
            var summary = Dashboard.Summary;
            if (summary is null)
                return "Failure summary unavailable";

            var coverage = summary.Complete ? string.Empty : " Monitoring coverage is incomplete.";
            return $"{summary.FailureCount:N0} failures across {summary.AffectedApplicationCount:N0} applications in the last {summary.WindowSeconds} seconds.{coverage}";
        }
    }

    protected override void OnInitialized() => Dashboard.Changed += OnDashboardChanged;

    private void OnDashboardChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Dashboard.Changed -= OnDashboardChanged;
}
