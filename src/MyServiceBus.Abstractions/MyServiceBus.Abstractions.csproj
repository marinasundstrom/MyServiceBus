<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(EnableNet11RuntimeAsyncTarget)' != 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(EnableNet11RuntimeAsyncTarget)' == 'true'">net11.0</TargetFramework>
    <Features Condition="'$(EnableNet11RuntimeAsyncTarget)' == 'true'">$(Features);runtime-async=on</Features>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Sundstrom.MyServiceBus.Abstractions</PackageId>
    <Description>Portable messaging contracts and abstractions for MyServiceBus.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
