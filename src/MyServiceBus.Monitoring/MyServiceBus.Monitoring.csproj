<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Sundstrom.MyServiceBus.Monitoring</PackageId>
    <Description>Optional batched runtime monitoring exporter and collector protocol for MyServiceBus.</Description>
    <PackageTags>$(PackageTags);monitoring;observability</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MyServiceBus.Inspection/MyServiceBus.Inspection.csproj" />
  </ItemGroup>

</Project>
