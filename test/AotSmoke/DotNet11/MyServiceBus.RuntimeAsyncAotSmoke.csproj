<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <Features>runtime-async=on</Features>
    <EnableNet11RuntimeAsyncTarget>true</EnableNet11RuntimeAsyncTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/MyServiceBus/MyServiceBus.csproj" />
    <ProjectReference Include="../../../src/MyServiceBus.Generators/MyServiceBus.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
