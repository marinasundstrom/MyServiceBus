<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MassTransit.Newtonsoft" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MyServiceBus.Serialization.Bson/MyServiceBus.Serialization.Bson.csproj" />
    <ProjectReference Include="../../src/MyServiceBus.Inspection/MyServiceBus.Inspection.csproj" />
    <ProjectReference Include="../../src/MyServiceBus.Monitoring.Server/MyServiceBus.Monitoring.Server.csproj" />
    <ProjectReference Include="../../src/MyServiceBus/MyServiceBus.csproj" />
    <ProjectReference Include="../../src/MyServiceBus.Testing/MyServiceBus.Testing.csproj" />
    <ProjectReference Include="../../src/TestApp/TestApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../fixtures/protocol/v1/*.json"
          Link="protocol-fixtures/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/topology/v2/*.json"
          Link="topology-fixtures/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/choreography/v1/*.json"
          Link="choreography-fixtures/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/serialization/v1/*.base64"
          Link="serialization-fixtures/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/scheduling/v1/*.json"
          Link="scheduling-fixtures/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
